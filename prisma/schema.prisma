// ---------- Finance ----------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
}

enum InvoiceSource {
  SERVICE
  PART
  FEE
  APPROVAL
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  jobId         String?       @unique
  job           ServiceJob?   @relation(fields: [jobId], references: [id])
  invoiceNumber String        @unique
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  subtotalSen   Int           @default(0)
  /**
   * Promotional discount, snapshotted from the booking at completion. Marketing reads this
   * as the campaign discount cost, so a checkout discount must NOT be written here.
   */
  discountSen   Int           @default(0)
  /**
   * Manual checkout discount. Kept apart from discountSen so a cashier's goodwill gesture
   * cannot corrupt campaign ROI. See src/modules/finance/invoice-discount.ts.
   */
  manualDiscountSen    Int       @default(0)
  manualDiscountKind   String?   // "PERCENT" | "AMOUNT"
  manualDiscountValue  Int?      // what was typed: a percent (10) or an amount in sen
  manualDiscountReason String?
  manualDiscountAt     DateTime?
  taxSen        Int           @default(0)
  totalSen      Int           @default(0)
  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  description  String
  quantity     Int          @default(1)
  unitPriceSen Int
  lineTotalSen Int
  source       InvoiceSource @default(SERVICE)
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  EWALLET
  PAY_LATER
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amountSen Int
  method    PaymentMethod @default(CASH)
  status    String        @default("PAID")
  paidAt    DateTime      @default(now())
}

