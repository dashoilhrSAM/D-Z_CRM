  action         String
  entity         String
  entityId       String?
  before         String?
  after          String?
  ip             String?
  createdAt      DateTime @default(now())
}

// ---------- Phone OTP ----------

/**
 * 手机验证码的发送审计 + 频率限制数据源。
 *
 * 为什么不复用 Message 表：Message.customerId 是必填外键，而**首次注册时 Customer 还不存在**
 * （验证码正是用来确认"这个号码归谁"的），所以 OTP 没有客户可挂。硬塞进 Message 会逼出
 * 一个假的 customerId——那比多一张表糟糕得多。
 *
 * 生命周期：action 先写一条 REQUESTED（这就是限流的计数依据），hook 真发出去后把同一行
 * 更新成 SENT / FAILED，verify 成功再补 verifiedAt。因此这一行同时回答三个问题：
 * 发了没、发成功没、验过了没。
 *
 * ipHash 存的是哈希（AUTH_SECRET 加盐），不是原文：这张表里有手机号，
 * 位置信息再落原文就成了可以直接画像的数据集，而限流只需要"同一个人"这个等价值。
 */
model OtpAttempt {
  id         String   @id @default(cuid())
  phoneE164  String
  purpose    String
  ipHash     String?
  provider   String?
  externalId String?
  status     String   @default("REQUESTED")
  error      String?
  createdAt  DateTime @default(now())
  verifiedAt DateTime?

  @@index([phoneE164, createdAt])
  @@index([ipHash, createdAt])
}

model IntegrationConfig {
  id              String   @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  provider        String   // WHATSAPP | SMS | EMAIL | PAYMENT | STORAGE | OPENAI
  channel         String?
  configEncrypted String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([organisationId, provider])
}

/// 佣金规则（P1）：一条规则 = 一个作用域 + 一种算法。
///
/// 为什么 basis 是**枚举而不是"百分比和固定额两个字段都填"**：两个字段都存在时，
/// "都设置了怎么办"就成了运行时猜谜，而金额算错是会计事故。改成枚举后"同时设置"在数据层
/// 无法表达；真要"5% + 每件 RM2"就显式用 COMBO。
///
/// targetKey 是**查找键**而不是外键（有意）：PRODUCT/SERVICE/PACKAGE 存对应行的 id，
/// CATEGORY 存分类名，DEFAULT 为 null。四个多态外键会带来"哪个为空就用哪个"的模糊判断，
/// 而解析器只需要按 (scope, targetKey) 精确查。
model CommissionRule {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  scope          String   // PRODUCT | SERVICE | CATEGORY | PACKAGE | DEFAULT
  targetKey      String?  // 见上（DEFAULT 为 null）
  basis          String   // PERCENT | FIXED | COMBO
  value          Int      @default(0) // PERCENT → 百分点×100（5.25% = 525）；FIXED → sen；COMBO → 不用
  valuePercent   Int?     // 仅 COMBO
  valueFixedSen  Int?     // 仅 COMBO：每件固定额（sen）
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?
  priority       Int      @default(0) // 同层冲突时的兜底（越大越优先）
  active         Boolean  @default(true)
  note           String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId, scope, active])
  @@index([organisationId, scope, targetKey])
}

/// 佣金台账（P2）：**唯一真相，只追加**。
///
/// 为什么是"只追加、永不 UPDATE 金额"：佣金会被拿计算器核对，也会进工资单。
/// 改错应当是**追加一条 ADJUSTMENT（带 reason）**，而不是把原值改掉——
/// 否则"上个月他到底拿了多少"就再也说不清（历史工资单与银行流水会对不上）。
///
/// @@unique([jobItemId, kind]) 是幂等的核心：同一行同一类型只能有一条，
/// 于是"完工流程被重跑两次"在**数据库层**就不可能产生第二条（不是靠代码自觉）。
/// jobItemId 可空（调整/冲正行没有对应的工单行），而 SQL 里唯一索引把 NULL 视为互不相同，
/// 所以多条无行的调整不会互相顶掉 —— 这是有意利用的行为。
model CommissionLedger {
  id             String   @id @default(cuid())
  organisationId String
  branchId       String?
  userId         String   // 受益人（技师）
  jobId          String?
  jobItemId      String?
  /// P4b：零件行（ServiceJobPart）的计提也走台账，用独立的 id 保证幂等（唯一键见文件尾）
  jobPartId      String?
  invoiceId      String?
  kind           String   // BASE | PENDING | LEGACY | TIER_BONUS | ADJUSTMENT | REVERSAL
  amountSen      Int      // 可为负（冲正/调整）
  basis          String   // PERCENT | FIXED | COMBO | LEGACY | MANUAL
  baseSen        Int      @default(0) // 计算基数（该行折后净额），用来解释"为什么是这个数"
  qty            Int      @default(1)
  ruleId         String?
  ruleSnapshot   String?  // 规则内容快照：事后改规则不影响历史
  /// P3：件数要按作用域统计（单 SKU / 单个服务 / 一个分类 / 全店），所以台账行必须自带
  /// "这一行是什么" —— 与 ruleSnapshot 同一个道理：统计不该再去 join 工单行（那行可能被改，
  /// 而台账是既成事实）。三列都可空：历史行与未链接行本来就是空的。
  productId      String?
  serviceTypeId  String?
  category       String?
  tierSetId      String?
  tierSnapshot   String?
  reason         String?  // 人工调整/冲正/PENDING 的原因
  actorUserId    String?
  reversalOfId   String?  // 冲正指向的原台账行
  earnedAt       DateTime // 计提时点（业务口径：决定落在哪个结算窗口）
  windowKey      String   // 冗余窗口键，如 "2026-09"
  createdAt      DateTime @default(now())

  @@unique([jobItemId, kind])
  /// 零件行（P4b）的幂等键：与 jobItemId 同理 —— NULL 在唯一索引里互不相同，
  /// 所以服务行的多条 NULL 不会互顶，零件行也能各自只写一条。
  @@unique([jobPartId, kind])
  @@index([organisationId, userId, windowKey])
  @@index([jobId])
  @@index([invoiceId])
}

/// 阶梯组合（P3）：一个组合绑定一个作用域（单 SKU / 单个服务 / 一个分类 / 全店），内含若干档。
///
/// **刻意不存"当前件数"计数器**：件数一律从台账推导（窗口内 BASE 行的合计）。
/// 计数器 + 定时清零是这类系统最经典的事故源（漏跑一次就算错，而且没人会发现）；
/// 窗口天然切换则让"重置"这件事在架构上不存在。
model CommissionTierSet {
  id             String   @id @default(cuid())
  organisationId String
  name           String   // 如 "机油买十送二"
  scope          String   // PRODUCT | SERVICE | CATEGORY | ALL
  targetId       String?  // scope 对应的对象（ALL 为 null）
  windowKind     String   @default("MONTH") // MONTH（按门店时区 MYT 自然月）
  countUnit      String   @default("ITEM_QTY") // ITEM_QTY（件）| LINE_COUNT（行）
  rewardKind     String   // ONE_OFF_FIXED | EXTRA_PER_UNIT_FIXED | FREE_UNIT_COMMISSION
  /// EXTRA_PER_UNIT_FIXED 的追溯开关：true = 窗口内**全部**合格件都算，false = 只算跨过门槛之后的新件。
  retroactive    Boolean  @default(true)
  active         Boolean  @default(true)
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime @default(now())
  tiers          CommissionTier[]

  @@index([organisationId, active])
}

/// 组合里的一档：达到 thresholdQty 件时触发，rewardValue 按组合的 rewardKind 解释。
model CommissionTier {
  id           String @id @default(cuid())
  tierSetId    String
  tierSet      CommissionTierSet @relation(fields: [tierSetId], references: [id], onDelete: Cascade)
  thresholdQty Int    // 达到多少件触发（含）
  rewardValue  Int    // sen（一次性/每件固定）
  note         String?
  @@unique([tierSetId, thresholdQty])
}

/// 领取记录（P3）：**"可领取"是推导出来的，不是存出来的**——
/// 窗口内该技师有效件数 ≥ thresholdQty 且这里没有对应行 = 可领取。
/// 唯一键保证"同一人同一档同一窗口只能领一次"，于是不存在"状态字段忘了改"这种可能。
model CommissionClaim {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  tierSetId      String
  tierId         String
  windowKey      String   // 归属窗口，如 "2026-09"
  claimedQty     Int      // 领取时的窗口件数快照（用于解释与争议）
  amountSen      Int      // 领取时算出的金额快照
  ledgerId       String?  // 生成的台账行（TIER_BONUS）
  claimedAt      DateTime @default(now())

  @@unique([userId, tierId, windowKey])
  @@index([organisationId, userId, windowKey])
}

/// 发票计数器（2026-09-23）：发票号必须**原子**分配。
///
/// 为什么单独一张表：原来是 count(该年发票) + 1 —— 两个并发的完工事务读到同一个 count，
/// 第二张发票撞唯一键，**整个完工事务回滚**（发票、收款、库存扣减、佣金、服务提醒一起没了）。
/// 本项目早已写明「凡读出当前值 → 判断 → 写回，都必须原子写」，这里是漏网的一处。
/// 另：count 还有一个隐患 —— 删掉一张发票会让号码回退、与既有发票重号。
///
/// 按**年份全局**编号（与既有发票号 DZ-YYYY-NNNNN 的语义一致：invoiceNumber 是全局唯一键）。
model InvoiceCounter {
  year  Int @id
  /// 已发出的最后一个号码（不是「下一个」）—— 语义写清楚才不会在边界上出错
  value Int
}

/// 文档（文档通路 P0）：客户证件、保险单、发票、采购单、供应商文件、员工证件……
///
/// 三条刻意的设计：
///  ① **只存 storageKey，绝不存 URL** —— 上一版 Attachment 存的是公开 URL，
///     客户身份证走那条路等于「知道链接就能看」。读取一律经 /api/documents/[id]/file 鉴权。
///  ② 关联用**显式字符串外键**（与台账表同一风格）：一次要连八种对象，加 Prisma relation 得改八个模型。
///  ③ 状态与保留期都在数据里：上传 ≠ 有效（保险到期要能自动 EXPIRED），到期要能自动归档。
model Document {
  id             String    @id @default(cuid())
  organisationId String
  branchId       String?
  /// CUSTOMER_ID | INSURANCE | WARRANTY | INVOICE | QUOTE | PURCHASE_ORDER | SUPPLIER_DOC | STAFF_DOC | PHOTO | OTHER
  kind           String
  /// UPLOADED | VERIFIED | REJECTED | ARCHIVED | EXPIRED | DELETED
  status         String    @default("UPLOADED")
  /// 私有桶对象键（private/ 前缀），**不是 URL**
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  /// 内容哈希：去重与完整性校验（同一份证件重复上传可识别）
  sha256         String

  customerId      String?
  motorcycleId    String?
  leadId          String?
  bookingId       String?
  jobId           String?
  invoiceId       String?
  purchaseOrderId String?
  supplierId      String?

  uploadedById String?
  uploadedAt   DateTime  @default(now())
  /// 审核留痕：谁看的、什么时候、什么结论
  verifiedById String?
  verifiedAt   DateTime?
  verifyNote   String?

  /// 到期日（按类型算，见 lib/documents/validate.ts）；legalHold 为真则永不自动删
  retainUntil DateTime?
  legalHold   Boolean   @default(false)
  /// 软删：默认查不到，但审计要留得下来
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organisationId, branchId, status])
  @@index([customerId])
  @@index([jobId])
  @@index([invoiceId])
  @@index([retainUntil])
}
