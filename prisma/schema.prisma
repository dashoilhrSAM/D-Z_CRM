// ---------- Marketing ----------

enum CampaignType {
  RETURN
  REMINDER
  PROMO
  NEWS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

model Campaign {
  id             String         @id @default(cuid())
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  name           String
  type           CampaignType   @default(RETURN)
  audience       String?        // legacy code: ALL | NEW | 30_DAYS | 60_DAYS | OVERDUE
  audienceRules  Json?          // MKT-005..012: declarative segment rules (see modules/marketing/audience.ts)
  status         CampaignStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  discountPercent Int?                       // PROMO only: 1-100
  // MKT-014: bonus loyalty points awarded when a booking attributed to this campaign
  // completes, on top of the normal service points.
  pointsBonus    Int?
  createdAt      DateTime       @default(now())
  bookings       Booking[]
  leads          Lead[]
}

model MarketingAsset {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  title       String
  type        String   @default("POSTER")
  month       String?
  description String?
  url         String?
  published   Boolean  @default(true) // show on Rider News (workshop controls per-poster)
  createdAt   DateTime @default(now())
}

model ContentScript {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  title      String
  platform   String   @default("TIKTOK")
  hook       String?
  body       String
  tone       String?
  createdAt  DateTime @default(now())

  // ---------- Content engine (P4) ----------
  // A candidate is simply a ContentScript that has not been chosen yet, so the existing
  // Script Bank page keeps working unchanged while gaining the candidate workflow.
  /// MANUAL | CANDIDATE | SELECTED | REJECTED | USED
  status          String   @default("MANUAL")
  /// MANUAL | AI
  source          String   @default("MANUAL")
  /// Groups the candidates produced by one generation run, so a whole batch can be
  /// reviewed or discarded together.
  batchId         String?
  /// The angle this candidate takes — what makes it different from its siblings.
  angle           String?
  cta             String?
  language        String?
  /// Which brand voice produced it (BrandProfile.key).
  brandKey        String?
  /// What it was written for: an occasion window and/or a trend structure.
  occasionKey     String?
  trendKey        String?
  /// The product toggle: whether this script shows a product, and which one.
  includeProduct  Boolean  @default(false)
  productSku      String?
  /// Model self-assessment and its reason for picking this angle.
  score           Int?
  reasoning       String?
  generatedAt     DateTime?

  // ---------- Expansion + poster (P5/P6) ----------
  /// The finished content: captions per platform, hashtags, poster lines, publish note.
  /// Persisted so a refresh does not throw away work the operator has just reviewed.
  expandedJson    Json?
  expandedAt      DateTime?
  /// Rendered poster PNG, served from the storage provider.
  posterUrl       String?
  posterRenderedAt DateTime?
  /// When the operator marked this as posted. status stays the source of truth (USED);
  /// this only records when, so "posted last week" is answerable without reading audit logs.
  usedAt          DateTime?

  @@index([batchId])
  @@index([status])
}
