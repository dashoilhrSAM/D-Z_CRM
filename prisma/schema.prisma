/// **已弃用（2026-09-23）**：改用 Document 表（私有存储 + 状态 + 保留期）。
///
/// 为什么还留着：这张表存的是**公开 URL**，而它已经被 Document 取代（客户页已切换）。
/// 但**不能现在删** —— 构建期的 schema 同步脚本刻意拒绝 DROP（防止误删生产数据），
/// 删模型会让每次部署直接失败。等确认线上 0 行且无引用后，再单独走一次带备份的清理。
model Attachment {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  relatedType    String   // CUSTOMER | LEAD | VEHICLE | JOB | ...
  relatedId      String
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  url            String
  uploadedById   String?
  createdAt      DateTime @default(now())
}

