// D&Z Platform — core data model
// Money is stored as integer SEN (RM1.00 = 100). Never use floats for money.
// All business records carry organisationId (multi-tenant); most carry branchId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity / Tenancy ----------

enum Role {
  SUPER_ADMIN
  OWNER
  HEAD_OFFICE_ADMIN
  MANAGER
  SALES_MANAGER
  SALES_ADVISOR
  SERVICE_MANAGER
  SERVICE_ADVISOR
  COUNTER_STAFF
  CUSTOMER_SERVICE
  MECHANIC
  PARTS_MANAGER
  INVENTORY
  MARKETING
  ACCOUNTING
  AUDITOR
}

model Organisation {
  id            String   @id @default(cuid())
  qrToken       String?  @unique // QR-003: unguessable scan token
  name          String
  currency      String   @default("MYR")
  // PLT-005 company profile
  logo          String?
  address       String?
  contactPhone  String?
  contactEmail  String?
  taxId         String?
  timezone      String   @default("Asia/Kuala_Lumpur")
  operatingHours String? // JSON {mon:"09:00-18:00",...}
  lostReasons    String? // JSON array of configurable closed-lost reasons (PIPE-013)
  // Foreman salary rules: { baseSen, commissionType: "per_job"|"percent_sales"|"flat", commissionValue, addonBonusSen? }
  salaryRules    Json?
  enableMotorcycleQr Boolean @default(true)
  enableRiderProfileQr Boolean @default(true)
  enableWorkshopQr   Boolean  @default(true)
  // Legacy column that exists ONLY in the production database (never in this schema or
  // in any migration). It predates the three enable*Qr flags above and is unreferenced
  // by all code. @ignore keeps Prisma from selecting it AND from wanting to DROP it on
  // every schema sync. Retire it with a deliberate migration when convenient.
  qrEnabled      Boolean  @default(true) @ignore
  // MKT-013: when true, any booking during a live promo is discounted automatically,
  // not just bookings that arrived through a campaign link. Marketing controls this.
  promoAutoApply Boolean @default(true)
  createdAt     DateTime @default(now())
  branches      Branch[]
  users         User[]
  customers     Customer[]
  products      Product[]
  suppliers     Supplier[]
  leads         Lead[]
  leadSources   LeadSource[]
  leadStages    LeadStage[]
  tasks         Task[]
  testRides     TestRide[]
  serviceTypes  ServiceType[]
  automationRules AutomationRule[]
  messageTemplates MessageTemplate[]
  loyaltyTiers  LoyaltyTier[]
  loyaltyAccounts LoyaltyAccount[]
  rewards       Reward[]
  referrals     Referral[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  integrationConfigs IntegrationConfig[]
  promoProducts PromoProduct[]
  brandProfiles BrandProfile[]
  occasions     Occasion[]
  permissions   Permission[]
  roleConfigs   RoleConfig[]
  serviceHistory ServiceHistory[]
}


/// A dated moment worth planning content around.
///
/// Not just festivals: for a motorcycle workshop the *rhythm* around a date matters more
/// than the date itself — the long-distance travel rush before a major holiday, the
/// monsoon months, the school-break travel peaks, payday. `angleHint` carries that
/// editorial angle so generation knows what to actually say, not merely that a date exists.
///
/// Reference data with an optional organisation override: organisationId null means the
/// row is shared nationwide calendar data.
model Occasion {
  id             String    @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  /// Stable identifier, e.g. MY-2026-RAYA-AIDILFITRI or MY-PAYDAY-2026-09
  key            String    @unique
  name           String
  nameEn         String?
  nameZh         String?
  /// Dates are stored at UTC midnight (project convention) so they never shift with timezone.
  startDate      DateTime
  endDate        DateTime?
  /// FESTIVAL | NATIONAL | SCHOOL_HOLIDAY | PAYDAY | MONSOON | INDUSTRY
  type           String
  /// 1-5, how much this matters to a motorcycle workshop. 5 = peak demand driver.
  relevance      Int       @default(3)
  /// How many days before startDate content should begin (pre-travel service window).
  leadDays       Int       @default(7)
  /// The editorial angle: what the workshop should actually say or offer.
  angleHint      String?
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([startDate])
  @@index([type])
}

// ---------- Marketing content engine ----------

/// Promotion-only product catalogue.
///
/// Deliberately SEPARATE from `Product`, which models sellable inventory (cost price,
/// stock levels, suppliers, purchase orders). These rows are brand assets used to
/// compose marketing content — they are acquired for promotion, never stocked, never
/// invoiced, and therefore carry no cost/stock fields. Keeping them apart means adding
/// a promo product can never affect inventory or finance reporting.
model PromoProduct {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  sku            String       @unique
  brand          String?      // DASHCIL | DASHOIL | D&Z
  category       String?      // ENGINE_OIL | CHAIN_LUBE | COOLANT | GEAR_OIL
  series         String?      // E | H | S | R  (product family)
  volume         String?      // "1.2L", "400ml"
  /// Transparent cut-out for compositing onto generated poster backgrounds.
  imageUrl       String?      // /products/<sku>.png
  description    String?
  /// Structured label facts, e.g. { viscosity, api, jaso, badges }
  specs          Json?
  /// Marketing angles and selling points (JSON array of strings).
  sellingPoints  String?
  /// Short copy the model may reuse verbatim — anything else it must not invent.
  approvedCopy   String?
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// Per-brand voice and guardrails for content generation.
///
/// Holds the answer to "根据我们的内容": what each brand sounds like, what it may claim
/// and what it must never say. Generation reads this instead of guessing a tone.
model BrandProfile {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  key             String       // DZ_WORKSHOP | DASHCIL | DASHOIL
  name            String
  tagline         String?
  /// Tone-of-voice description handed to the model.
  voice           String?
  primaryLanguage String       @default("ms") // ms | en | zh
  /// JSON array of language codes to produce, e.g. ["ms","en","zh"]
  languages       String?
  /// JSON array of audience descriptions.
  audiences       String?
  /// JSON array of things the brand always does.
  dos             String?
  /// JSON array of hard prohibitions (wrong claims, banned words, competitor jabs).
  donts           String?
  /// JSON array of posts the team considers good, used as few-shot style anchors.
  samplePosts     String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organisationId, key])
}


model Branch {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  city           String
  phone          String?
  address        String?
  isMain         Boolean      @default(false)
  operatingHours String?      // JSON {mon:"09:00-18:00",...}
  appointmentCapacity Int     @default(1)
  users          User[]
  customers      Customer[]
  bookings       Booking[]
  jobs           ServiceJob[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  reviews        Review[]
  campaigns      Campaign[]
  marketingAssets MarketingAsset[]
  contentScripts ContentScript[]
  messages       Message[]
  notifications  Notification[]
  testRides      TestRide[]
  appointmentSlots AppointmentSlot[]
  inventoryLocations InventoryLocation[]
  leads          Lead[]
  tasks          Task[]
  serviceHistory ServiceHistory[]
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id])
  name           String
  phone          String?
  email          String?
  role           Role     @default(MECHANIC)
  active         Boolean  @default(true)
  // SUPABASE AUTH: auth.users.id (production login); null = demo-only user
  authId         String?  @unique
  // AUTH: login credentials (legacy prototype auth, superseded by Supabase Auth)
  passwordHash   String?
  lastLoginAt    DateTime?
  emailVerified  Boolean   @default(false)
  mfaSecret      String?   // TOTP secret for admin MFA
  verifyToken    String?   // email verification token
  resetToken     String?   // password reset token
  resetTokenExpiresAt DateTime?
  failedLoginCount Int    @default(0)
  lockedUntil     DateTime?
  createdAt      DateTime @default(now())
  jobs           ServiceJob[]     @relation("AssignedMechanic")
  notifications  Notification[]
  leadsAssigned  Lead[]           @relation("AssignedLeads")
  tasksOwned     Task[]           @relation("OwnedTasks")
  tasksCompleted Task[]           @relation("CompletedTasks")
  testRidesAssigned TestRide[]    @relation("SalespersonTestRides")
  payouts        StaffPayout[]   @relation("StaffPayouts")
  attendance     Attendance[]
  /** 个人提成算法 { commissionType, commissionValue, addonBonusSen? } — null 用 org 默认 */
  commissionRules String?
}

// ---------- Customers ----------

model Customer {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id])
  name           String
  phone          String?
  email          String?
  // SUPABASE AUTH: auth.users.id (rider production login); null = demo customer
  authId         String?  @unique
  qrToken        String?  @unique // QR-002: unguessable scan token (created on signup)
  gender         String?
  joinedAt       DateTime @default(now())
  address        String?
  // Rider 通知偏好: {serviceReminders, bookingUpdates, marketingOffers, appNews}
  notificationPrefs Json?
  source         String?
  notes          String?
  internalNotes  String?
  tags           String?
  authProfile    CustomerAuthProfile?
  motorcycles    Motorcycle[]
  bookings       Booking[]
  jobs           ServiceJob[]
  messages       Message[]
  reviews        Review[]
  reminders      ServiceReminder[]
  invoices       Invoice[]
  notifications  Notification[]
  createdAt      DateTime @default(now())
  addresses      CustomerAddress[]
  consent        CustomerConsent?
  loyaltyAccount LoyaltyAccount?
  leadsConverted Lead[]
  testRides      TestRide[]
  serviceHistory ServiceHistory[]
  referralsMade  Referral[]     @relation("ReferralsMade")
  referralsReceived Referral[]   @relation("ReferralsReceived")
}

model CustomerAuthProfile {
  id             String   @id @default(cuid())
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id])
  pin            String?
  phoneVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// ---------- Motorcycles ----------

model Motorcycle {
  id                   String    @id @default(cuid())
  qrToken              String?   @unique // QR-001: unguessable scan token
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id])
  brand                String
  model                String
  year                 Int
  plate                String    @unique
  vin                  String?
  engineNo             String?
  color                String?
  type                 String    @default("UNDERBONE") // MotorcycleType key (lib/motorcycle-types)
  currentMileage       Int       @default(0)
  purchaseDate         DateTime?
  warrantyExpiry       DateTime?
  warrantyKm           Int?
  notes                String?
  // denormalised service snapshot (updated transactionally on completion)
  lastServiceDate      DateTime?
  lastServiceMileage   Int?
  lastOilChangeMileage Int?
  lastOilFilterMileage Int?
  nextServiceMileage   Int?
  nextServiceEstDate   DateTime?
  createdAt            DateTime  @default(now())
  jobs                 ServiceJob[]
  bookings             Booking[]
  reminders            ServiceReminder[]
  testRides            TestRide[]
  serviceHistory       ServiceHistory[]
}

// ---------- Bookings ----------

enum BookingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  RIDER_APP
  COUNTER
  PHONE
}

model Booking {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  motorcycleId  String
  motorcycle    Motorcycle    @relation(fields: [motorcycleId], references: [id])
  serviceType   String
  // RIDER BOOK: structured service — package + add-ons (synced to job on check-in)
  servicePackageId String?
  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id])
  serviceAddons    Json? // [{ description, kind, quantity, unitPriceSen }]
  date          DateTime
  timeSlot      String
  notes         String?
  status        BookingStatus @default(REQUESTED)
  type          JobType       @default(SERVICE)
  source        BookingSource @default(RIDER_APP)
  campaignId    String?       // promo attribution: which campaign drove this booking
  campaign      Campaign?     @relation(fields: [campaignId], references: [id])
  // MKT-013: promo applied at booking time, snapshotted so the quoted price stays
  // stable even if the campaign is later edited or expires.
  promoDiscountSen Int        @default(0)
  promoSnapshot    Json?      // { campaignId, campaignName, discountPercent, originalSen, discountedSen, savedSen }
  jobId         String?       @unique
  job           ServiceJob?   @relation(fields: [jobId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ---------- Service Jobs ----------

enum JobStatus {
  WAITING
  IN_PROGRESS
  AWAITING_APPROVAL
  QC_CHECK
  WAITING_PARTS
  ON_HOLD
  READY
  COMPLETED
  CANCELLED
}

enum JobType {
  SERVICE
  REPAIR
}

enum ItemStatus {
  INCLUDED
  RECOMMENDED
  ACCEPTED
  DECLINED
}

enum ItemSource {
  PACKAGE
  COUNTER
  APPROVAL
  MANUAL
}

model ServiceJob {
  id              String     @id @default(cuid())
  jobNumber       String     @unique
  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  motorcycleId    String
  motorcycle      Motorcycle @relation(fields: [motorcycleId], references: [id])
  booking         Booking?
  mechanicId      String?
  mechanic        User?      @relation("AssignedMechanic", fields: [mechanicId], references: [id])
  servicePackageId String?
  servicePackage  ServicePackage? @relation(fields: [servicePackageId], references: [id])
  packageName     String?
  mileage         Int
  customerRequest String?
  status          JobStatus  @default(WAITING)
  type            JobType    @default(SERVICE)
  estimatedCompletionAt DateTime? // JOB-016: estimated ready time (derived from service duration)
  startedAt       DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           ServiceJobItem[]
  parts           ServiceJobPart[]
  findings        InspectionFinding[]
  approvals       CustomerApproval[]
  checklist       ChecklistExecution?
  reviews         Review[]
  invoice         Invoice?
  reminder        ServiceReminder?
  messages        Message[]  @relation("JobMessages")
  statusHistory   JobStatusHistory[]
  serviceHistory  ServiceHistory?
  photos          ServiceJobPhoto[]
  quotation       Quotation?
  /** 该 job 给技师的手工提成（sen）；null=按个人算法结算时自动算 */
  commissionSen   Int?
  /** 该 job 给技师的手工奖金（sen）；结算时可手填 */
  bonusSen        Int?
}

// ---------- Mechanic pre-service SOP photos (开工前拍照记录) ----------

enum JobPhotoAngle {
  FRONT
  BACK
  LEFT
  RIGHT
  METER // 仪表(里程读数)
}

model ServiceJobPhoto {
  id           String        @id @default(cuid())
  jobId        String
  job          ServiceJob    @relation(fields: [jobId], references: [id])
  angle        JobPhotoAngle
  photoUrl     String
  capturedById String?
  capturedAt   DateTime      @default(now())
  // 每工单每角度一张：重拍即 upsert 覆盖
  @@unique([jobId, angle])
}

// ---------- Pre-service quotation (开工前报价确认) ----------

enum QuotationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Quotation {
  id          String         @id @default(cuid())
  jobId       String         @unique
  job         ServiceJob     @relation(fields: [jobId], references: [id])
  status      QuotationStatus @default(PENDING)
  revision    Int            @default(1)
  totalSen    Int            @default(0)
  itemsJson   String?        // 报价行快照 [{description,qty,unitPriceSen,lineTotalSen,kind}]
  sentAt      DateTime       @default(now())
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ServiceJobItem {
  id           String     @id @default(cuid())
  jobId        String
  job          ServiceJob @relation(fields: [jobId], references: [id])
  description  String
  kind         String     @default("SERVICE") // SERVICE | FEE | ADDON
  quantity     Int        @default(1)
  unitPriceSen Int
  lineTotalSen Int
  status       ItemStatus @default(INCLUDED)
  source       ItemSource @default(PACKAGE)
  createdAt    DateTime   @default(now())
}

model ServiceJobPart {
  id           String     @id @default(cuid())
  jobId        String
  job          ServiceJob @relation(fields: [jobId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int        @default(1)
  unitCostSen  Int
  unitPriceSen Int
  lineTotalSen Int
  status       ItemStatus @default(INCLUDED)
  source       ItemSource @default(PACKAGE)
  createdAt    DateTime   @default(now())
}

// ---------- Checklists / Inspections ----------

enum CheckResult {
  PASS
  WARNING
  FAIL
  NA
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  name      String
  branchId  String?
  isDefault Boolean  @default(false)
  items     ChecklistItem[]
}

model ChecklistItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
  name       String
  order      Int
  category   String?
}

model ChecklistExecution {
  id         String    @id @default(cuid())
  jobId      String    @unique
  job        ServiceJob @relation(fields: [jobId], references: [id])
  templateId String?
  startedAt  DateTime  @default(now())
  completedAt DateTime?
  items      ChecklistExecutionItem[]
}

model ChecklistExecutionItem {
  id          String               @id @default(cuid())
  executionId String
  execution   ChecklistExecution   @relation(fields: [executionId], references: [id])
  checklistItemId String?
  name        String
  result      CheckResult          @default(NA)
  note        String?
  photoUrl    String?
  createdAt   DateTime             @default(now())
}

enum FindingStatus {
  OPEN
  RECOMMENDED
  APPROVED
  DECLINED
  RESOLVED
}

model InspectionFinding {
  id               String        @id @default(cuid())
  jobId            String
  job              ServiceJob    @relation(fields: [jobId], references: [id])
  executionItemId  String?
  title            String
  severity         String        @default("WARNING") // WARNING | FAIL
  note             String?
  recommendedRepair String?
  priceSen         Int?
  status           FindingStatus @default(RECOMMENDED)
  approval         CustomerApproval?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
}

model CustomerApproval {
  id          String         @id @default(cuid())
  jobId       String
  job         ServiceJob     @relation(fields: [jobId], references: [id])
  findingId   String         @unique
  finding     InspectionFinding @relation(fields: [findingId], references: [id])
  title       String
  description String?
  amountSen   Int
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  respondedAt DateTime?
}

// ---------- Service Packages ----------

enum PackageTier {
  GOOD
  BETTER
  BEST
}

model ServicePackage {
  id           String   @id @default(cuid())
  branchId     String?
  name         String
  tier         PackageTier
  priceSen     Int
  description  String?
  isBestValue  Boolean  @default(false)
  active       Boolean  @default(true)
  items        ServicePackageItem[]
  jobs         ServiceJob[]
  bookings     Booking[]
}

model ServicePackageItem {
  id         String         @id @default(cuid())
  packageId  String
  package    ServicePackage @relation(fields: [packageId], references: [id])
  name       String
  kind       String         @default("SERVICE")
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id])
  defaultQty Int            @default(1)
  priceSen   Int            @default(0)
}

// ---------- Inventory ----------

model Product {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  sku            String   @unique
  manufacturerPartNo String?
  barcode        String?
  imageUrl       String? // product photo (public/products/<sku>.png)
  category       String?
  brand          String?
  unit           String   @default("unit")
  sellPriceSen   Int
  costPriceSen   Int
  minStock       Int      @default(5)
  safetyStock    Int      @default(2)
  leadTimeDays   Int      @default(3)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  active         Boolean  @default(true)
  compatibleModels String? // JSON array of motorcycle-type keys
  createdAt      DateTime @default(now())
  inventories    Inventory[]
  stockMovements StockMovement[]
  jobParts       ServiceJobPart[]
  poItems        PurchaseOrderItem[]
  packageItems   ServicePackageItem[]
}

model Inventory {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(0)
  @@unique([branchId, productId])
}

model StockMovement {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int // signed: negative = consumed/out
  reason        String
  referenceType String?
  referenceId   String?
  userId        String?
  createdAt     DateTime @default(now())
}

// ---------- Suppliers / Purchasing ----------

model Supplier {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  leadTimeDays   Int      @default(3)
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  status     POStatus @default(DRAFT)
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?
  totalSen   Int      @default(0)
  createdAt  DateTime @default(now())
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCostSen     Int
  lineTotalSen    Int
  receivedQty     Int           @default(0)
}

// ---------- Finance ----------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
}

enum InvoiceSource {
  SERVICE
  PART
  FEE
  APPROVAL
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  jobId         String?       @unique
  job           ServiceJob?   @relation(fields: [jobId], references: [id])
  invoiceNumber String        @unique
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  subtotalSen   Int           @default(0)
  discountSen   Int           @default(0)
  taxSen        Int           @default(0)
  totalSen      Int           @default(0)
  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  description  String
  quantity     Int          @default(1)
  unitPriceSen Int
  lineTotalSen Int
  source       InvoiceSource @default(SERVICE)
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  EWALLET
  PAY_LATER
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amountSen Int
  method    PaymentMethod @default(CASH)
  status    String        @default("PAID")
  paidAt    DateTime      @default(now())
}

// ---------- CRM ----------

enum ReminderStatus {
  UPCOMING
  DUE_SOON
  DUE
  OVERDUE
  BOOKED
  COMPLETED
}

model ServiceReminder {
  id                 String         @id @default(cuid())
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  motorcycleId       String
  motorcycle         Motorcycle     @relation(fields: [motorcycleId], references: [id])
  jobId              String?        @unique
  job                ServiceJob?    @relation(fields: [jobId], references: [id])
  status             ReminderStatus @default(UPCOMING)
  lastServiceMileage Int
  intervalKm         Int            @default(3000)
  nextServiceMileage Int
  estimatedDate      DateTime?
  createdAt          DateTime       @default(now())
  closedAt           DateTime?
}

enum MessageDirection {
  OUT
  IN
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
  APP
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
}

model Message {
  id            String          @id @default(cuid())
  organisationId String
  branchId      String?
  branch        Branch?         @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  direction     MessageDirection @default(OUT)
  channel       MessageChannel  @default(WHATSAPP)
  body          String
  status        MessageStatus   @default(SENT)
  referenceType String?
  referenceId   String?
  externalId    String?          // Meta WhatsApp Graph API message id（投递回执关联键）
  jobId         String?
  job           ServiceJob?     @relation("JobMessages", fields: [jobId], references: [id])
  createdAt     DateTime        @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  title      String
  body       String?
  type       String    @default("INFO")
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

enum ReviewStatus {
  REQUESTED
  SUBMITTED
  PUBLISHED
  SKIPPED
}

model Review {
  id         String       @id @default(cuid())
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id])
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  jobId      String?
  job        ServiceJob?  @relation(fields: [jobId], references: [id])
  rating     Int?
  comment    String?
  source     String       @default("APP")
  status     ReviewStatus @default(REQUESTED)
  reply      String?
  repliedAt  DateTime?
  requestedAt DateTime?
  createdAt  DateTime     @default(now())
}

// ---------- Marketing ----------

enum CampaignType {
  RETURN
  REMINDER
  PROMO
  NEWS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

model Campaign {
  id             String         @id @default(cuid())
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  name           String
  type           CampaignType   @default(RETURN)
  audience       String?        // legacy code: ALL | NEW | 30_DAYS | 60_DAYS | OVERDUE
  audienceRules  Json?          // MKT-005..012: declarative segment rules (see modules/marketing/audience.ts)
  status         CampaignStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  discountPercent Int?                       // PROMO only: 1-100
  // MKT-014: bonus loyalty points awarded when a booking attributed to this campaign
  // completes, on top of the normal service points.
  pointsBonus    Int?
  createdAt      DateTime       @default(now())
  bookings       Booking[]
  leads          Lead[]
}

model MarketingAsset {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  title       String
  type        String   @default("POSTER")
  month       String?
  description String?
  url         String?
  published   Boolean  @default(true) // show on Rider News (workshop controls per-poster)
  createdAt   DateTime @default(now())
}

model ContentScript {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  title      String
  platform   String   @default("TIKTOK")
  hook       String?
  body       String
  tone       String?
  createdAt  DateTime @default(now())
}
// ---------- Requirements §30 DATA: missing entities ----------

model RoleConfig {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  @@unique([organisationId, name])
}

model Permission {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  roleName       String
  module         String
  canView        Boolean  @default(false)
  canCreate      Boolean  @default(false)
  canEdit        Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canExport      Boolean  @default(false)
  scope          String   @default("BRANCH") // BRANCH | ALL_BRANCHES
  createdAt      DateTime @default(now())
  @@unique([organisationId, roleName, module])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String   @default("HOME") // HOME | WORK | BILLING
  line1      String?
  line2      String?
  city       String?
  state      String?
  postcode   String?
  country    String   @default("MY")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerConsent {
  id                      String   @id @default(cuid())
  customerId              String   @unique
  customer                Customer @relation(fields: [customerId], references: [id])
  marketingOptIn          Boolean  @default(false)
  whatsappOptIn           Boolean  @default(false)
  smsOptIn                Boolean  @default(false)
  emailOptIn              Boolean  @default(false)
  communicationPreference String   @default("WHATSAPP") // WHATSAPP | SMS | EMAIL | PHONE | APP
  consentedAt             DateTime?
  updatedAt               DateTime @updatedAt
}

model LeadSource {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  leads          Lead[]
}

model LeadStage {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  leads          Lead[]
}

model Lead {
  id                  String     @id @default(cuid())
  leadNumber          String     @unique
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id])
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  sourceId            String?
  source              LeadSource? @relation(fields: [sourceId], references: [id])
  stageId             String?
  stage               LeadStage?  @relation(fields: [stageId], references: [id])
  customerName        String
  phone               String?
  email               String?
  motorcycleInterest  String?
  modelInterest       String?
  notes               String?
  estimatedValueSen   Int?
  assignedUserId      String?
  assignedUser        User?      @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  nextFollowUpAt      DateTime?
  tags                String?
  status              String     @default("OPEN") // OPEN | WON | LOST
  lostReason          String?
  convertedCustomerId String?
  convertedCustomer   Customer?  @relation(fields: [convertedCustomerId], references: [id])
  // MKT-015: which campaign drove this lead (null = organic / unknown)
  campaignId          String?
  campaign            Campaign?  @relation(fields: [campaignId], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  activities          LeadActivity[]
  testRides           TestRide[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String   // CREATED | ASSIGNED | STAGE_CHANGED | NOTE | FOLLOW_UP | TEST_RIDE | WON | LOST
  note      String?
  userId    String?
  createdAt DateTime @default(now())
}

model Task {
  id            String    @id @default(cuid())
  organisationId String
  organisation  Organisation @relation(fields: [organisationId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  ownerId       String?
  owner         User?     @relation("OwnedTasks", fields: [ownerId], references: [id])
  title         String
  description   String?
  relatedType   String?   // LEAD | CUSTOMER | BOOKING | VEHICLE | JOB
  relatedId     String?
  dueAt         DateTime?
  priority      String    @default("NORMAL") // LOW | NORMAL | HIGH
  status        String    @default("OPEN") // OPEN | COMPLETED | CANCELLED
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("CompletedTasks", fields: [completedById], references: [id])
}

model TestRide {
  id            String     @id @default(cuid())
  organisationId String
  organisation  Organisation @relation(fields: [organisationId], references: [id])
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id])
  leadId        String?
  lead          Lead?      @relation(fields: [leadId], references: [id])
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  motorcycleModel String
  motorcycleId  String?
  motorcycle    Motorcycle? @relation(fields: [motorcycleId], references: [id])
  rideDate      DateTime
  timeSlot      String?
  salespersonId String?
  salesperson   User?      @relation("SalespersonTestRides", fields: [salespersonId], references: [id])
  status        String     @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
  notes         String?
  createdAt     DateTime   @default(now())
}

model AppointmentSlot {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  date        DateTime
  startTime   String
  endTime     String?
  maxBookings Int      @default(1)
  bookedCount Int      @default(0)
  isHoliday   Boolean  @default(false)
  @@unique([branchId, date, startTime])
}

// ---------- Foreman salary payouts ----------

model StaffPayout {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("StaffPayouts", fields: [userId], references: [id])
  period        String   // "day" | "week" | "month"
  periodStart   DateTime // 周期起点（UTC，periodWindow 的 start）
  baseSen       Int      @default(0)
  commissionSen Int      @default(0)
  addonBonusSen Int      @default(0)
  bonusSen      Int      @default(0) // 结算时老板手填的奖金
  totalSen      Int
  status        String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  payments      StaffPayoutPayment[]
  @@unique([userId, period, periodStart])
}

model StaffPayoutPayment {
  id        String      @id @default(cuid())
  payoutId  String
  payout    StaffPayout @relation(fields: [payoutId], references: [id])
  amountSen Int
  method    String      @default("CASH")
  paidAt    DateTime    @default(now())
}

// ---------- Mechanic attendance (check in / out) ----------

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  date       DateTime  // 业务日 UTC 零点
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())
  @@unique([userId, date])
}

model ServiceType {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  code           String?
  category       String?
  durationMin    Int?
  priceSen       Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model JobStatusHistory {
  id         String     @id @default(cuid())
  jobId      String
  job        ServiceJob @relation(fields: [jobId], references: [id])
  fromStatus String?
  toStatus   String
  userId     String?
  note       String?
  changedAt  DateTime   @default(now())
}

model ServiceHistory {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id])
  branchId          String
  branch            Branch       @relation(fields: [branchId], references: [id])
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id])
  motorcycleId      String
  motorcycle        Motorcycle   @relation(fields: [motorcycleId], references: [id])
  jobId             String?      @unique
  job               ServiceJob?  @relation(fields: [jobId], references: [id])
  serviceDate       DateTime
  mileage           Int
  serviceAdvisorId  String?
  technicianId      String?
  serviceItems      String?      // JSON
  partsUsed         String?      // JSON
  labour            String?      // JSON
  totalSen          Int          @default(0)
  nextServiceMileage Int?
  nextServiceDate   DateTime?
  createdAt         DateTime     @default(now())
}

model InventoryLocation {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  code      String?
  createdAt DateTime @default(now())
}

model AutomationRule {
  id             String    @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  triggerType    String    // EVENT | TIME
  trigger        String    // LEAD_CREATED | LEAD_STAGE_CHANGED | BOOKING_CREATED | BOOKING_APPROACHING | SERVICE_COMPLETED | SERVICE_DUE | JOB_READY | CUSTOMER_INACTIVE | LOYALTY_EVENT | LOW_STOCK
  conditions     String?   // JSON
  actions        String    // JSON array
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  executions     AutomationExecution[]
}

model AutomationExecution {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id])
  trigger    String
  status     String         @default("SUCCESS") // SUCCESS | FAILED
  error      String?
  executedAt DateTime       @default(now())
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  channel        String   @default("WHATSAPP") // WHATSAPP | SMS | EMAIL | APP
  subject        String?
  body           String
  placeholders   String?  // JSON
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model LoyaltyTier {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  name           String
  minPoints      Int              @default(0)
  benefits       String?
  active         Boolean          @default(true)
  accounts       LoyaltyAccount[]
}

model LoyaltyAccount {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  customerId     String            @unique
  customer       Customer          @relation(fields: [customerId], references: [id])
  tierId         String?
  tier           LoyaltyTier?      @relation(fields: [tierId], references: [id])
  membershipId   String            @unique
  pointsBalance  Int               @default(0)
  totalEarned    Int               @default(0)
  totalRedeemed  Int               @default(0)
  memberSince    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  transactions   LoyaltyTransaction[]
  redemptions    RewardRedemption[]
}

model LoyaltyTransaction {
  id            String         @id @default(cuid())
  accountId     String
  account       LoyaltyAccount @relation(fields: [accountId], references: [id])
  type          String         // EARN | REDEEM | ADJUST | EXPIRE
  points        Int            // signed
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  userId        String?
  createdAt     DateTime       @default(now())
}

model Reward {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  name           String
  description    String?
  pointsRequired Int
  active         Boolean          @default(true)
  singleUse      Boolean          @default(true)
  createdAt      DateTime         @default(now())
  redemptions    RewardRedemption[]
}

model RewardRedemption {
  id          String         @id @default(cuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id])
  rewardId    String
  reward      Reward         @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  status      String         @default("REDEEMED") // REDEEMED | CANCELLED
  redeemedAt  DateTime       @default(now())
}

model Referral {
  id                  String    @id @default(cuid())
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id])
  referringCustomerId String
  referringCustomer   Customer  @relation("ReferralsMade", fields: [referringCustomerId], references: [id])
  referredCustomerId  String?
  referredCustomer    Customer? @relation("ReferralsReceived", fields: [referredCustomerId], references: [id])
  referredLeadId      String?
  code                String
  status              String    @default("PENDING") // PENDING | QUALIFIED | REWARDED | EXPIRED
  rewardStatus        String?
  qualifiedAt         DateTime?
  createdAt           DateTime  @default(now())
}

model Attachment {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  relatedType    String   // CUSTOMER | LEAD | VEHICLE | JOB | ...
  relatedId      String
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  url            String
  uploadedById   String?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  branchId       String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  before         String?
  after          String?
  ip             String?
  createdAt      DateTime @default(now())
}

model IntegrationConfig {
  id              String   @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  provider        String   // WHATSAPP | SMS | EMAIL | PAYMENT | STORAGE | OPENAI
  channel         String?
  configEncrypted String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([organisationId, provider])
}

