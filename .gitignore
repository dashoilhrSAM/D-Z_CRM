# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/dev.db
prisma/dev.db-journal

# e2e
prisma/e2e.db
prisma/e2e.db-journal
playwright-report/
test-results/
/storage/
browser-screenshots/

# catalogue product photo source (runtime copy lives in public/motorcycles)
DZ_Motorcycle_Product_Images/
Part_Catalogue/

# pnpm local store
.pnpm-store/

# prisma engine cache redirect (sandbox: XDG_CACHE_HOME=$PWD/.cache for prisma generate)
.cache/

# local db backups (trial data snapshots)
prisma/*.db.bak-*
prisma/*.db-*

# D&Z teaching PPT build artifacts
.ppt-build/
docs/ppt-assets/

# tutorial screenshots + generated guide (large artifacts)
tutorial-screens/
docs/*User Guide*.docx
app-screenshots/

# production database dumps (contains customer PII — never commit)
docs/backups/

# 压测库/临时库：绝不该进 git（2026-09-23 差点被 git add -A 带进去）
prisma/perf*.db
prisma/*.db-journal
